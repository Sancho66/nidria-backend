              }
            ],
            "title": "Origin Country"
          },
          "dest_country": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dest Country"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "steps_done": {
            "type": "integer",
