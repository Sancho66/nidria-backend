  "components": {
    "schemas": {
      "CommentResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "author_type": {
            "type": "string",
            "title": "Author Type"
          },
          "author_label": {
            "type": "string",
            "title": "Author Label"
          },
          "is_mine": {
            "type": "boolean",
            "title": "Is Mine"
          },
          "body": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Body"
          },
          "document_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Id"
          },
          "edited": {
            "type": "boolean",
            "title": "Edited"
          },
          "deleted": {
            "type": "boolean",
            "title": "Deleted"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "author_type",
          "author_label",
          "is_mine",
          "body",
          "document_id",
          "edited",
          "deleted",
          "created_at",
          "updated_at"
        ],
        "title": "CommentResponse",
        "description": "One message in a step thread, shaped identically for both faces.\nNo raw `author_id` is exposed (respects the expat exclusion contract /\nno internal UUID): `author_label` carries the resolved display name\nand `is_mine` (computed from the authenticated identity) drives the\nedit/delete affordances. `body` is null for a soft-deleted message\n(the row stays so the thread keeps its order — front renders\n\"message supprimé\")."
      },
      "CustomFieldDefinitionInline": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "key": {
            "type": "string",
            "title": "Key"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "field_type": {
            "type": "string",
            "title": "Field Type"
          },
          "options": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Options"
          },
          "required": {
            "type": "boolean",
            "title": "Required"
          },
          "position": {
            "type": "integer",
            "title": "Position"
          },
          "scope": {
            "type": "string",
            "title": "Scope"
          }
        },
        "type": "object",
        "required": [
          "id",
          "key",
          "label",
          "field_type",
          "options",
          "required",
          "position",
          "scope"
        ],
        "title": "CustomFieldDefinitionInline",
        "description": "Active custom-field definitions, embedded in the case detail so\nthe frontend renders the person form in one fetch (no second call /\nno cross-case cache staleness)."
      },
      "DeadlineCounter": {
        "properties": {
          "target_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Date"
          },
          "days_remaining": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Days Remaining"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          }
        },
        "type": "object",
        "required": [
          "target_date",
          "days_remaining",
          "source"
        ],
        "title": "DeadlineCounter",
        "description": "Resolved days-remaining counter for a step, computed backend-side\nso both faces read the same number. `target_date` is the firm\n`due_at` if set (source=\"deadline\"), else started_at + estimated_days\n(source=\"estimated\"), else null (source=null → no gauge). The\ngreen/orange/red thresholds are a FRONT decision on `days_remaining`\n(negative = overdue)."
      },
      "DemoSessionRequest": {
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "title": "Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code"
        ],
        "title": "DemoSessionRequest"
      },
      "DemoSessionResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "const": "bearer",
            "title": "Token Type",
            "default": "bearer"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In",
            "default": 7200
          },
          "case_id": {
            "type": "string",
            "format": "uuid",
            "title": "Case Id"
          },
          "language": {
            "type": "string",
            "enum": [
              "fr",
              "en",
              "es",
              "ru",
              "pt",
              "it",
              "hu"
            ],
            "title": "Language"
          },
          "read_only": {
            "type": "boolean",
            "const": true,
            "title": "Read Only",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "case_id",
          "language"
        ],
        "title": "DemoSessionResponse"
      },
      "ExpatAgencyPendingResponse": {
        "properties": {
          "agency_id": {
            "type": "string",
